{
  "name": "mospolytech-help",
  "version": "1.0.0",
  "description": "Неофициальный справочник студентов Московского Политеха",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "check:links": "node scripts/check-links.mjs",
    "check:content": "node scripts/check-content.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "wrangler pages deploy dist --project-name polytech-help",
    "verify": "npm run check:content && npm run check:coverage && npm run check && npm run build && npm run check:links",
    "check:coverage": "node scripts/check-coverage.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/set-night/mospolytech-help.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/set-night/mospolytech-help/issues"
  },
  "homepage": "https://github.com/set-night/mospolytech-help#readme",
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^7.4.4",
    "pagefind": "^1.5.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.155.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
