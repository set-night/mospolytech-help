---
import '@fontsource-variable/manrope';
import '@fontsource-variable/golos-text';
import '../styles/global.css';
import '../features/navigation/header.css';
import '../features/brand/identity.css';
import '../features/seo/seo.css';
import Search from '../components/Search.astro';
import Icon from '../components/Icon.astro';
import Artwork, { type Motif } from '../features/brand/Artwork.astro';
import { repository } from '../lib/data';
import { buildMetadata, type ArticleMetadata, type Breadcrumb } from '../features/seo/metadata';
interface Props {
  title?: string;
  description?: string;
  kind?: 'WebPage' | 'CollectionPage' | 'AboutPage';
  breadcrumbs?: Breadcrumb[];
  article?: ArticleMetadata;
  indexable?: boolean;
}
const {
  title = 'Справочник студентов Московского Политеха',
  description = 'Расписание, навигация, документы и ответы на вопросы студентов Московского Политеха. Открытый неофициальный справочник с источниками.',
  kind,
  breadcrumbs,
  article,
  indexable = true,
} = Astro.props;
const isHome = Astro.url.pathname === '/';
const path = Astro.url.pathname;
const motif: Motif = path.startsWith('/resources')
  ? 'route'
  : path.startsWith('/community')
    ? 'rosette'
    : path.startsWith('/topics') || path === '/articles/'
      ? 'fan'
      : path.startsWith('/articles/')
        ? 'orbits'
        : 'wave';
const currentSection = /^\/(articles|topics)\//.test(Astro.url.pathname)
  ? '/articles/'
  : Astro.url.pathname;
const seo = buildMetadata({
  title,
  description,
  pathname: Astro.url.pathname,
  kind,
  breadcrumbs,
  article,
});
const nav = [
  { href: '/', title: 'Главная', icon: 'home' },
  { href: '/articles/', title: 'Справочник', icon: 'book' },
  { href: '/resources/', title: 'Сервисы', icon: 'grid' },
  { href: '/community/', title: 'Чаты и медиа', icon: 'chat' },
] as const;
---

<!doctype html>
<html lang="ru" data-theme="dark" class:list={{ 'home-page': isHome }}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline src="/theme-init.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#1e1e1e" />
    <title>{seo.title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={indexable ? 'index,follow,max-image-preview:large' : 'noindex,follow'}
    />
    <link rel="canonical" href={seo.canonical} />
    <link rel="icon" href="/favicon.svg?v=4" type="image/svg+xml" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:site_name" content="polytech.help" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:image" content="https://polytech.help/images/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="polytech.help — справочник студентов Московского Политеха"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://polytech.help/images/og.png" />
    <meta
      name="twitter:image:alt"
      content="polytech.help — справочник студентов Московского Политеха"
    />
    {article && <meta property="article:modified_time" content={article.modifiedAt} />}
    {indexable && <script type="application/ld+json" is:inline set:html={seo.jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      К содержимому
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="polytech.help — на главную">
          <span class="brand-wordmark">
            polytech<span>.help</span>
          </span>
        </a>
        <div class="header-actions">
          <button class="header-search icon-button" data-open-search aria-label="Открыть поиск">
            <Icon name="search" />
          </button>
          <button id="theme-toggle" class="icon-button" aria-label="Включить светлую тему">
            <Icon name="sun" class="theme-sun" />
            <Icon name="moon" class="theme-moon" />
          </button>
          <a class="icon-button header-github" href={repository} aria-label="Репозиторий на GitHub">
            <Icon name="github" />
          </a>
          <button
            id="menu-toggle"
            class="menu-toggle icon-button"
            aria-expanded="false"
            aria-controls="mobile-nav"
            aria-label="Открыть меню"
          >
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </header>
    <nav id="mobile-nav" class="mobile-nav" aria-label="Навигация по сайту" hidden>
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={
            Astro.url.pathname === item.href
              ? 'page'
              : currentSection === item.href
                ? 'true'
                : undefined
          }
        >
          <Icon name={item.icon} size={17} />
          {item.title}
        </a>
      ))}
      <a href={`${repository}/blob/main/CONTRIBUTING.md`} class="menu-contribute">
        <Icon name="github" size={17} /> Дополнить справочник <Icon name="arrow" size={15} />
      </a>
    </nav>
    {!isHome && (
      <div class="page-identity" aria-hidden="true">
        <Artwork id="page-art" motif={motif} />
      </div>
    )}
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div class="footer-invitation" data-reveal>
        <div>
          <span class="eyebrow">ЭТОТ СПРАВОЧНИК МОЖЕТ СТАТЬ ЛУЧШЕ</span>
          <p>С твоим ответом.</p>
        </div>
        <a class="contribute footer-cta" href={`${repository}/blob/main/CONTRIBUTING.md`}>
          Дополнить справочник{' '}
          <span>
            <Icon name="arrow" size={25} />
          </span>
        </a>
        <Artwork id="footer-art" motif="wave" class="footer-ribbon" />
      </div>
      <div class="footer-bottom">
        <a href="/" class="footer-wordmark">
          polytech<span>.help</span>
        </a>
        <span class="footer-note">Неофициальный проект студентов</span>
        <nav aria-label="Ссылки в подвале">
          <a href="/articles/">Справочник</a>
          <a href="/community/">Чаты и медиа</a>
          <a href={`${repository}/issues/new?template=correction.yml`}>Ошибка?</a>
          <a href="/about/">О проекте</a>
          <a href={repository}>
            GitHub <Icon name="github" size={14} />
          </a>
        </nav>
      </div>
    </footer>
    <Search />
    <script>
      import '../features/theme/theme';
      import '../features/motion/motion';
      import '../features/brand/favicon';
      import '../features/navigation/menu';
    </script>
  </body>
</html>
