---
import '@fontsource-variable/manrope';
import '@fontsource-variable/golos-text';
import '../styles/global.css';
import Search from '../components/Search.astro';
import { repository } from '../lib/data';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Политех, по-человечески',
  description = 'Неофициальный справочник Московского Политеха. Учёба, общежитие, документы и ответы на студенческие вопросы — с источниками.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ed3046" />
    <title>{title} — polytech.help</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:image" content="https://polytech.help/images/og.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      К содержимому
    </a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="polytech.help — на главную">
          polytech<span>.help</span>
          <span class="brand-note">НЕОФИЦИАЛЬНЫЙ СПРАВОЧНИК</span>
        </a>
        <nav class="desktop-nav" aria-label="Основная навигация">
          <a
            href="/articles/"
            aria-current={Astro.url.pathname.startsWith('/articles') ? 'page' : undefined}
          >
            Справочник
          </a>
          <a href="/resources/">Ресурсы</a>
          <a href="/community/">Чаты и медиа</a>
        </nav>
        <div class="header-actions">
          <button class="header-search" data-open-search aria-label="Открыть поиск">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6" />
              <path d="m16 16 5 5" stroke="currentColor" stroke-width="1.6" />
            </svg>
            <kbd>⌘ K</kbd>
          </button>
          <button
            id="menu-toggle"
            class="menu-toggle"
            aria-expanded="false"
            aria-controls="mobile-nav"
            aria-label="Открыть меню"
          >
            <span></span>
            <span></span>
          </button>
        </div>
      </header>
      <nav id="mobile-nav" class="mobile-nav" aria-label="Мобильная навигация" hidden>
        <a href="/articles/">Справочник ↗</a>
        <a href="/resources/">Полезные ресурсы ↗</a>
        <a href="/community/">Чаты и медиа ↗</a>
        <a href={`${repository}/blob/main/CONTRIBUTING.md`}>Дополнить справочник ↗</a>
      </nav>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <div>
          <a href="/" class="footer-brand">
            polytech.help<span>↗</span>
          </a>
          <p>
            Сделано студентами для студентов.
            <br />
            Неофициальный проект Московского Политеха.
          </p>
        </div>
        <div class="footer-links">
          <a href={`${repository}/blob/main/CONTRIBUTING.md`}>Как добавить материал ↗</a>
          <a href={repository}>Исходный код на GitHub ↗</a>
          <a href={`${repository}/issues/new?template=correction.yml`}>Сообщить об ошибке ↗</a>
          <a href="/about/">О проекте и источниках</a>
        </div>
      </footer>
    </div>
    <Search />
    <script>
      const button = document.querySelector<HTMLButtonElement>('#menu-toggle')!;
      const nav = document.querySelector<HTMLElement>('#mobile-nav')!;
      button.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
        nav.hidden = !open;
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !nav.hidden) {
          nav.hidden = true;
          button.setAttribute('aria-expanded', 'false');
          button.setAttribute('aria-label', 'Открыть меню');
          button.focus();
        }
      });
      const observer = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }),
        { threshold: 0.08 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
      document.documentElement.classList.add('js');
    </script>
  </body>
</html>
