---
import '@fontsource-variable/manrope';
import '@fontsource-variable/golos-text';
import '../styles/global.css';
import Search from '../components/Search.astro';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import Ribbon from '../features/browse/Ribbon.astro';
import { repository } from '../lib/data';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Справочник студентов Московского Политеха',
  description = 'Расписание, навигация, документы и ответы на вопросы студентов Московского Политеха. Открытый неофициальный справочник с источниками.',
} = Astro.props;
const isHome = Astro.url.pathname === '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { href: '/', title: 'Главная' },
  { href: '/articles/', title: 'Справочник' },
  { href: '/resources/', title: 'Сервисы' },
  { href: '/community/', title: 'Чаты и медиа' },
];
---

<!doctype html>
<html lang="ru" data-theme="dark" class:list={{ 'home-page': isHome }}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline src="/theme-init.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#1e1e1e" />
    <title>{title} — polytech.help</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:image" content="https://polytech.help/images/og.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      К содержимому
    </a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a class="brand" href="/" aria-label="polytech.help — на главную">
          <span class="brand-symbol" aria-hidden="true">
            <BrandMark />
          </span>
          <span class="brand-wordmark">
            polytech<span>.help</span>
          </span>
        </a>
        <nav class="desktop-nav" aria-label="Основная навигация">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
            >
              {item.title}
            </a>
          ))}
        </nav>
        <div class="header-actions">
          <button class="header-search icon-button" data-open-search aria-label="Открыть поиск">
            <Icon name="search" />
            <kbd>⌘ K</kbd>
          </button>
          <span class="header-divider"></span>
          <button id="theme-toggle" class="icon-button" aria-label="Включить светлую тему">
            <Icon name="sun" class="theme-sun" />
            <Icon name="moon" class="theme-moon" />
          </button>
          <a class="icon-button header-github" href={repository} aria-label="Репозиторий на GitHub">
            <Icon name="github" />
          </a>
          <button
            id="menu-toggle"
            class="menu-toggle icon-button"
            aria-expanded="false"
            aria-controls="mobile-nav"
            aria-label="Открыть меню"
          >
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </header>
    <nav id="mobile-nav" class="mobile-nav wrap" aria-label="Мобильная навигация" hidden>
      {nav.map((item) => (
        <a href={item.href}>{item.title} ↗</a>
      ))}
      <a href={`${repository}/blob/main/CONTRIBUTING.md`}>Дополнить справочник ↗</a>
    </nav>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div class="footer-invitation" data-reveal>
        <div>
          <span class="eyebrow">ЭТОТ СПРАВОЧНИК МОЖЕТ СТАТЬ ЛУЧШЕ</span>
          <p>С твоим ответом.</p>
        </div>
        <a class="contribute footer-cta" href={`${repository}/blob/main/CONTRIBUTING.md`}>
          Дополнить справочник{' '}
          <span>
            <Icon name="arrow" size={25} />
          </span>
        </a>
        <Ribbon class="footer-ribbon" />
      </div>
      <div class="footer-bottom">
        <a href="/" class="footer-wordmark">
          polytech<span>.help</span>
        </a>
        <span class="footer-note">Неофициальный проект студентов</span>
        <nav aria-label="Ссылки в подвале">
          <a href="/articles/">Справочник</a>
          <a href="/community/">Чаты и медиа</a>
          <a href={`${repository}/issues/new?template=correction.yml`}>Ошибка?</a>
          <a href="/about/">О проекте</a>
          <a href={repository}>
            GitHub <Icon name="github" size={14} />
          </a>
        </nav>
      </div>
    </footer>
    <Search />
    <script>
      import '../features/theme/theme';
      import '../features/motion/motion';
      const button = document.querySelector<HTMLButtonElement>('#menu-toggle')!;
      const nav = document.querySelector<HTMLElement>('#mobile-nav')!;
      function setMenu(open: boolean): void {
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
        nav.hidden = !open;
      }
      button.addEventListener('click', () => setMenu(nav.hidden !== false));
      document.addEventListener('keydown', (event) => {
        if (
          event.key === 'Escape' &&
          !nav.hidden &&
          !document.querySelector<HTMLDialogElement>('#search-dialog')?.open
        ) {
          setMenu(false);
          button.focus();
        }
      });
    </script>
  </body>
</html>
