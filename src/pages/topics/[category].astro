---
import Base from '../../layouts/Base.astro';
import Browse from '../../features/browse/Browse.astro';
import { categories } from '../../lib/data';
export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.id }, props: { category } }));
}
const { category } = Astro.props;
---

<Base
  title={`${category.title}: вопросы и инструкции студентам`}
  description={`${category.description}. Ответы для студентов Московского Политеха с источниками, инструкциями и полезными ссылками.`}
  kind="CollectionPage"
  breadcrumbs={[
    { title: 'Главная', path: '/' },
    { title: 'Справочник', path: '/articles/' },
    { title: category.title, path: `/topics/${category.id}/` },
  ]}
>
  <Browse category={category.id} />
</Base>
