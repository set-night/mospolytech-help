---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { categories, repository } from '../lib/data';
const articles = await getCollection('articles');
const popular = [
  'schedule',
  'student-account',
  'dormitories',
  'scholarships',
  'retakes',
  'student-certificate',
]
  .map((slug) => articles.find((article) => article.id === slug))
  .filter((article) => article !== undefined);
---

<Base>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>
        Политех,
        <br />
        <span>по-человечески</span>
        <span class="title-dot">.</span>
      </h1>
      <p>
        Учёба, документы и жизнь в университете.
        <br />
        Найди ответ — и занимайся своим.
      </p>
    </div>
    <button class="hero-search" data-open-search>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.5" />
        <path d="m16 16 5 5" stroke="currentColor" stroke-width="1.5" />
      </svg>
      <span>Что хочешь узнать?</span>
      <span class="search-example">Стипендия, общага, пересдача…</span>
      <kbd>Ctrl / ⌘ K</kbd>
    </button>
    <div class="quick-queries">
      <button data-open-search data-query="личный кабинет">
        Личный кабинет
      </button>
      <button data-open-search data-query="заселение">
        Заселение
      </button>
      <button data-open-search data-query="стипендия">
        Стипендия
      </button>
    </div>
  </section>
  <section class="daily-links wrap" aria-label="На каждый день">
    <a href="https://mosrasp.ru" target="_blank" rel="noopener noreferrer">
      <div>
        <h2>Какая сейчас пара?</h2>
        <p>МосРасписание</p>
      </div>
      <span aria-hidden="true">↗</span>
    </a>
    <a href="https://mpunav.ru" target="_blank" rel="noopener noreferrer">
      <div>
        <h2>А где эта аудитория?</h2>
        <p>МПУ Навигатор</p>
      </div>
      <span aria-hidden="true">↗</span>
    </a>
  </section>
  <section class="topics-section wrap" data-reveal>
    <div class="section-heading">
      <h2>Справочник</h2>
      <a class="text-link" href="/articles/">
        Все материалы ↗
      </a>
    </div>
    <div class="topic-grid">
      {categories.map((category) => (
        <a class="topic" href={`/topics/${category.id}/`}>
          <h3>
            {category.title}
            <span aria-hidden="true">↗</span>
          </h3>
          <p>{category.description}</p>
        </a>
      ))}
    </div>
  </section>
  <section class="popular-section wrap" data-reveal>
    <div class="section-heading">
      <h2>Частые вопросы</h2>
    </div>
    <div class="question-list">
      {popular.map((article) => (
        <a href={`/articles/${article.id}/`}>
          <h3>{article.data.title}</h3>
          <span class="question-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="help-strip wrap" data-reveal>
    <div>
      <h2>Нужны люди?</h2>
      <p>Официальные каналы и студенческие чаты.</p>
    </div>
    <a class="text-link" href="/community/">
      Найти своих ↗
    </a>
  </section>
  <section class="contribute wrap" data-reveal>
    <div>
      <h2>Знаешь ответ? Поделись.</h2>
      <p>Справочник открыт для твоих правок.</p>
    </div>
    <a class="text-link" href={`${repository}/blob/main/CONTRIBUTING.md`}>
      Как помочь проекту ↗
    </a>
  </section>
</Base>
